# Runs all 12 required spectral configurations.
# The four simulations at 0 and 45 degrees also record xy/xz field data.
# CAUTION: BFAST at high angles and dense frequency monitors can be expensive.
settings_nanorings;
for (case_index=1:2) {
    if (case_index == 1) {
        case_name = "A_air";
    } else {
        case_name = "B_SiO2";
    }
    for (angle_index=1:length(angles_deg)) {
        theta_deg = angles_deg(angle_index);
        record_nearfields = (theta_deg == 0) | (theta_deg == 45);
        output_base = output_prefix+"_"+case_name+"_"+
                      num2str(theta_deg)+"deg";
        ?"Starting "+output_base;
        build_nanorings;
        save(output_base+".fsp");
        run;
        analyze_nanorings;
    }
}
?"Finished the 12 requested simulations. Review spectra and resonance candidates.";
