# Requests are numeric TSV rows prepared by 03_review_resonances.py.
simulation_profile = "final";
settings_nanorings;
requests = readdata("../../results/resonances/nearfield_requests.tsv");
for (request_number=1:size(requests,1)) {
    request_id = requests(request_number,1);
    case_index = requests(request_number,2);
    theta_deg = requests(request_number,3);
    requested_wavelength_nm = requests(request_number,4);
    if ((theta_deg != 0) & (theta_deg != 45)) { error("Near-field angle must be 0 or 45"); }
    if (case_index == 1) { case_name = "A_air"; }
    else { case_name = "B_SiO2"; }
    output_base = "../../results/nearfields/request_"+num2str(request_id);
    if (!fileexists(output_base+".done")) {
        load("../../results/geometry/"+case_name+".fsp");
        switchtolayout;
        center_wavelength_nm = requested_wavelength_nm;
        configure_excitation;
        setglobalmonitor("use wavelength spacing",1);
        setglobalmonitor("frequency points",1);
        adddftmonitor;
        set("name","NF_XY");
        set("monitor type",7);
        set("x",0);
        set("x span",period_x);
        set("y",0);
        set("y span",period_y);
        set("z",xy_field_height);
        adddftmonitor;
        set("name","NF_XZ");
        set("monitor type",6);
        set("x",0);
        set("x span",period_x);
        set("y",0);
        set("z min",xz_field_z_min);
        set("z max",xz_field_z_max);
        save(output_base+".fsp");
        run("FDTD","GPU");
        field_xy = getresult("NF_XY","E");
        field_xz = getresult("NF_XZ","E");
        x_nm = field_xy.x*1e9;
        y_nm = field_xy.y*1e9;
        z_nm = field_xz.z*1e9;
        E2_xy = pinch(pinch(field_xy.E2,4,1),3,1);
        E2_xz = pinch(pinch(field_xz.E2,4,1),2,1);
        sampled_wavelength_nm = c/field_xy.f(1)*1e9;
        matlabsave(output_base,x_nm,y_nm,z_nm,E2_xy,E2_xz,requested_wavelength_nm,sampled_wavelength_nm);
        write(output_base+".done","complete","overwrite");
    }
}
