# Export field maps from an already completed 0 or 45 degree FDTD file.
# Review the TRA spectrum and candidates TSV, then set true resonance
# wavelengths below. These values are intentionally NOT invented.

# USER INPUT SECTION.
case_index = 1;                  # 1 = air, 2 = substrate
selected_theta_deg = 0;         # Only 0 or 45 are assigned field maps
resonance_wavelengths_nm = [800,1000];  # EXAMPLE ONLY: REPLACE WITH MEASURED VALUES

settings_nanorings;
if (case_index == 1) {
    case_name = "A_air";
} else {
    case_name = "B_SiO2";
}
output_base = output_prefix+"_"+case_name+"_"+
              num2str(selected_theta_deg)+"deg";
load(output_base+".fsp");

# E2 is squared field amplitude in the default CW-normalized monitor data.
# The source amplitude is 1 V/m in air: E2/(1 V/m)^2 is dimensionless.
field_xy = getresult("NF_XY","E");
field_xz = getresult("NF_XZ","E");
field_wavelength_nm = c/field_xy.f*1e9;

for (resonance_number=1:length(resonance_wavelengths_nm)) {
    desired_wavelength_nm = resonance_wavelengths_nm(resonance_number);
    closest_index = find(field_wavelength_nm,desired_wavelength_nm);
    sampled_wavelength_nm = field_wavelength_nm(closest_index);

    # Remove the frequency singleton dimension and the normal direction.
    # xy: Nx x Ny, xz: Nx x Nz.
    enhancement_xy = pinch(pinch(field_xy.E2,4,closest_index),3,1);
    enhancement_xz = pinch(pinch(field_xz.E2,4,closest_index),2,1);
    x_nm = field_xy.x*1e9;
    y_nm = field_xy.y*1e9;
    z_nm = field_xz.z*1e9;

    field_base = output_base+"_field_"+num2str(resonance_number)+"_"+
                 num2str(round(sampled_wavelength_nm))+"nm";
    matlabsave(field_base,x_nm,y_nm,z_nm,enhancement_xy,enhancement_xz,
               desired_wavelength_nm,sampled_wavelength_nm);

    if (export_plots == 1) {
        image(x_nm,y_nm,enhancement_xy,"x (nm)","y (nm)",
              "|E|^2 / |E0|^2, xy, "+num2str(sampled_wavelength_nm)+" nm");
        exportfigure(field_base+"_xy.jpg",900,700);
        image(x_nm,z_nm,enhancement_xz,"x (nm)","z (nm)",
              "|E|^2 / |E0|^2, xz, "+num2str(sampled_wavelength_nm)+" nm");
        exportfigure(field_base+"_xz.jpg",900,700);
        closeall;
    }
    ?"Exported field at sampled wavelength " + num2str(sampled_wavelength_nm)+" nm";
}
