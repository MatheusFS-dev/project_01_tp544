# Sanity check: remove the nanoring, retaining the background geometry.
# The suspended-air case should have R ~ 0, T ~ 1, A ~ 0.
# The bare-SiO2 case at 0 deg should approach Fresnel's R ~ 0.03374.

simulation_profile = "final";
case_index = 2;            # Set to 2 to check the bare air/SiO2 interface.
theta_deg = 0;
settings_nanorings;
if (case_index == 1) {
    case_name = "A_air";
} else {
    case_name = "B_SiO2";
}
output_base = "../../results/spectra/reference_"+case_name+"_"+num2str(theta_deg)+"deg";
load("../../results/geometry/"+case_name+".fsp");
switchtolayout;
select("Au_nanoring");
delete;
center_wavelength_nm = 0;
configure_excitation;
configure_power_monitors;
save(output_base+".fsp");
run("FDTD","GPU");
wavelength_nm = c/getdata("T_monitor","f")*1e9;
T = -transmission("T_monitor");
R = transmission("R_monitor");
A = 1-R-T;
write(output_base+".tsv","wavelength_nm\tT\tR\tA","overwrite");
write(output_base+".tsv",num2str([wavelength_nm,T,R,A],"%.12g"));
matlabsave(output_base,wavelength_nm,T,R,A);
