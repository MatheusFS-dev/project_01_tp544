# Analyze the current completed FDTD simulation.
# Caller must define output_base and remain in ANALYSIS mode.
# The +z normal of a z-normal monitor determines the power sign.

freq = getdata("T_monitor","f");
wavelength_nm = c/freq*1e9;
transmittance = -transmission("T_monitor");
reflectance = transmission("R_monitor");
absorptance = 1 - transmittance - reflectance;

# Keep raw, unclipped values. Negative A signals numerical/source errors.
spectrum = [wavelength_nm,transmittance,reflectance,absorptance];
write(output_base+"_TRA.tsv","wavelength_nm\tT\tR\tA","overwrite");
write(output_base+"_TRA.tsv",num2str(spectrum,"%.12g"));
matlabsave(output_base+"_TRA",wavelength_nm,transmittance,reflectance,absorptance);

?"Completed "+output_base;
?"Minimum A (should be approximately >= 0): "+num2str(min(absorptance));
?"Maximum A (should be approximately <= 1): "+num2str(max(absorptance));

if (export_plots == 1) {
    plot(wavelength_nm,transmittance,reflectance,absorptance,
         "Wavelength (nm)","Power fraction",output_base);
    legend("T","R","A");
    exportfigure(output_base+"_TRA.jpg",1200,720);
    closeall;
}

# Screening only: strong absorption maxima or transmission minima are
# resonance candidates, NOT definitive identification of plasmonic modes.
# Local contrast is compared with points about 30 nm on either side.
number_of_points = length(wavelength_nm);
window_points = 10;
contrast_threshold = 0.03;
write(output_base+"_candidates.tsv",
      "wavelength_nm\tindicator\tcontrast","overwrite");

for (candidate_index=(window_points+1):(number_of_points-window_points)) {
    left_index = candidate_index-window_points;
    right_index = candidate_index+window_points;

    if ((absorptance(candidate_index) > absorptance(candidate_index-1)) &&
        (absorptance(candidate_index) >= absorptance(candidate_index+1))) {
        contrast = absorptance(candidate_index) -
            max([absorptance(left_index),absorptance(right_index)]);
        if (contrast >= contrast_threshold) {
            write(output_base+"_candidates.tsv",
                num2str(wavelength_nm(candidate_index),"%.8g")+"\tA_peak\t"+
                num2str(contrast,"%.8g"));
        }
    }

    if ((transmittance(candidate_index) < transmittance(candidate_index-1)) &&
        (transmittance(candidate_index) <= transmittance(candidate_index+1))) {
        contrast = min([transmittance(left_index),transmittance(right_index)]) -
            transmittance(candidate_index);
        if (contrast >= contrast_threshold) {
            write(output_base+"_candidates.tsv",
                num2str(wavelength_nm(candidate_index),"%.8g")+"\tT_dip\t"+
                num2str(contrast,"%.8g"));
        }
    }
}
